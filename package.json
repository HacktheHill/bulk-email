{
	"$schema": "https://json.schemastore.org/package",
	"name": "bulk-email",
	"description": "Send bulk emails with React Email templates through AWS SES",
	"version": "2.1.0",
	"main": "dist/app.js",
	"module": "dist/app.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/HacktheHill/bulk-email"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/HacktheHill/bulk-email/issues"
	},
	"keywords": [
		"bulk",
		"email",
		"cli",
		"send",
		"ses",
		"react-email"
	],
	"type": "module",
	"scripts": {
		"start": "npx tsx src/app.ts",
		"build": "tsc",
		"test": "tsx --test test/*.test.ts test/*.test.tsx",
		"verify-unsub-token": "npx tsx src/verify-unsubscribe-token.ts"
	},
	"bin": "dist/app.js",
	"dependencies": {
		"@aws-sdk/client-sesv2": "^3.1085.0",
		"@react-email/components": "^1.0.8",
		"@react-email/render": "^1.1.2",
		"@types/fs-extra": "^9.0.13",
		"commander": "^9.4.1",
		"csv-parse": "^7.0.1",
		"dotenv": "^16.0.3",
		"fs-extra": "^11.1.0",
		"html-to-text": "^9.0.5",
		"inquirer": "^12.11.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"zod": "^3.20.2"
	},
	"devDependencies": {
		"@types/html-to-text": "^9.0.4",
		"@types/react": "^19.2.2",
		"esbuild": "^0.28.1",
		"tsx": "^4.23.0",
		"typescript": "^5.9.3"
	}
}
