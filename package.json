{
	"$schema": "https://json.schemastore.org/package",
	"name": "bulk-email",
	"description": "Send bulk emails with React Email templates through AWS SES",
	"version": "2.1.0",
	"private": true,
	"main": "dist/app.js",
	"module": "dist/app.js",
	"repository": {
		"type": "git",
		"url": "https://github.com/HacktheHill/bulk-email"
	},
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/HacktheHill/bulk-email/issues"
	},
	"keywords": [
		"bulk",
		"email",
		"cli",
		"send",
		"ses",
		"react-email"
	],
	"type": "module",
	"scripts": {
		"start": "tsx src/app.ts",
		"build": "tsc",
		"test": "tsx --test test/*.test.ts test/*.test.tsx",
		"typecheck": "tsc --noEmit",
		"lint": "eslint src test",
		"audit:prod": "npm audit --omit=dev --audit-level=high",
		"verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run audit:prod && npm audit --audit-level=high",
		"verify-unsub-token": "tsx src/verify-unsubscribe-token.ts"
	},
	"bin": "dist/app.js",
	"dependencies": {
		"@aws-sdk/client-sesv2": "3.1086.0",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"@smithy/node-http-handler": "4.9.5",
		"commander": "^15.0.0",
		"csv-parse": "^7.0.1",
		"dotenv": "^17.4.2",
		"fs-extra": "^11.3.6",
		"html-to-text": "^10.0.0",
		"inquirer": "^14.0.2",
		"react": "18.3.1",
		"react-dom": "18.3.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@types/fs-extra": "11.0.4",
		"@types/html-to-text": "^9.0.4",
		"@types/react": "18.3.28",
		"esbuild": "^0.28.1",
		"eslint": "10.7.0",
		"tsx": "^4.23.1",
		"typescript": "^5.9.3",
		"typescript-eslint": "8.64.0"
	}
}
